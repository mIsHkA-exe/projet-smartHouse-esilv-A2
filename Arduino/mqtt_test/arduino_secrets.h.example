// Modèle d'identifiants pour les tests MQTT (T2 à T7).
// Chemin : Arduino/mqtt_test/arduino_secrets.h.example (seul ce modèle est commité)
// Version : v2 (T6 : ajout du certificat de l'autorité de TEST)
//
// 1. Copier ce fichier en arduino_secrets.h dans le MÊME dossier.
// 2. Remplacer les valeurs ci-dessous.
// 3. arduino_secrets.h est ignoré par Git (.gitignore) : ne jamais le commiter.
//
// Réseau : partage de connexion du téléphone, en 2,4 GHz (D18).

#define SECRET_SSID       "NOM_DU_PARTAGE_DE_CONNEXION"
#define SECRET_PASS       "MOT_DE_PASSE_WIFI"

// Adresse IPv4 du PC sur le partage de connexion (relevée avec ipconfig).
// Doit être IDENTIQUE à IP.1 du certificat du broker (broker-test.cnf).
#define SECRET_BROKER_IP  "0.0.0.0"

// Compte de TEST créé avec mosquitto_passwd (à supprimer après les essais).
#define SECRET_MQTT_USER  "test-carte"
#define SECRET_MQTT_PASS  "MOT_DE_PASSE_DE_TEST"

// Certificat de l'autorité de TEST (contenu COMPLET de ca-test.crt, avec
// les lignes BEGIN et END). Ce n'est pas un secret (aucune clé privée),
// mais il dépend de la machine de test : il reste ici, hors du dépôt.
// TEST NÉGATIF : remplacer par le contenu de ca-autre.crt.
const char SECRET_CA_CERT[] = R"(-----BEGIN CERTIFICATE-----
COLLER ICI LE CONTENU DE ca-test.crt
-----END CERTIFICATE-----
)";
