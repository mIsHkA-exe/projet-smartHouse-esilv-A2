# =====================================================================
# Smart House — configuration du serveur (MODÈLE)
# Chemin : Server/.env.example (seul ce modèle est commité)
#
# 1. Copier ce fichier en Server/.env (ignoré par Git : ne JAMAIS le commiter).
# 2. Remplir les valeurs. Aucune valeur réelle ne doit apparaître ici.
# Les paramètres de fonctionnement validés (consigne, durées, conservation)
# ne sont pas ici : ils sont dans smarthouse/config.py.
# =====================================================================

# --- Broker MQTT (accès réservé à la machine, contrat § 5) -----------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Compte du serveur sur le broker (test-serveur pendant les essais).
MQTT_USERNAME=smarthouse-serveur
MQTT_PASSWORD=

# --- Chiffrement des images conservées (Fernet) ----------------------
# Générer une clé :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Clé perdue = images illisibles.
IMAGE_KEY=

# --- Dashboard ------------------------------------------------------
DASHBOARD_USERNAME=
# Hachage scrypt du mot de passe (outil fourni avec le dashboard).
DASHBOARD_PASSWORD_HASH=
# Secret de signature des sessions NiceGUI :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STORAGE_SECRET=

# HTTPS : certificat signé par l'autorité de l'équipe (hors du dépôt).
# Laisser vide = HTTP : UNIQUEMENT pour la phase « non protégée » de la
# démonstration d'attaque (E6).
HTTPS_CERTFILE=
HTTPS_KEYFILE=

# --- Données (base SQLite + images chiffrées) ------------------------
# Relatif au dossier Server/. Ne jamais commiter ce dossier.
DATA_DIR=data
